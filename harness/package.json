{
  "name": "netrunner-benchmark-harness",
  "private": true,
  "version": "0.1.0",
  "description": "Harness that seats language models at Android: Netrunner on the Chiriboga engine — either seat, against the rules AI or each other",
  "type": "module",
  "license": "GPL-3.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "run-game": "tsx src/cli.ts run-game",
    "batch": "tsx src/cli.ts batch",
    "determinism": "tsx src/cli.ts determinism",
    "golden": "tsx src/cli.ts golden",
    "invariant": "tsx src/cli.ts invariant",
    "selftest": "tsx src/cli.ts selftest",
    "llm-game": "tsx src/cli.ts llm-game",
    "run-match": "tsx src/cli.ts run-match",
    "replay": "tsx src/cli.ts replay",
    "frames": "tsx src/cli.ts frames",
    "corpus": "tsx src/cli.ts corpus",
    "site": "tsx src/cli.ts site",
    "pool": "tsx src/cli.ts pool",
    "smoke": "tsx src/cli.ts smoke",
    "fetch-rules": "tsx src/cli.ts fetch-rules",
    "audit": "tsx src/cli.ts audit",
    "format": "tsx src/cli.ts format",
    "test": "npm run typecheck && npm run determinism -- --seed 7"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "lz-string": "^1.5.0",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
