{
  "name": "netrunner-benchmark-harness",
  "private": true,
  "version": "0.1.0",
  "description": "Headless harness for LLM-vs-rules-AI Netrunner on the Chiriboga engine (Phase 1)",
  "type": "module",
  "license": "GPL-3.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "run-game": "tsx src/cli.ts run-game",
    "batch": "tsx src/cli.ts batch",
    "determinism": "tsx src/cli.ts determinism",
    "golden": "tsx src/cli.ts golden",
    "invariant": "tsx src/cli.ts invariant",
    "llm-game": "tsx src/cli.ts llm-game",
    "fetch-rules": "tsx src/cli.ts fetch-rules",
    "audit": "tsx src/cli.ts audit",
    "format": "tsx src/cli.ts format",
    "test": "npm run typecheck && npm run determinism -- --seed 7"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "lz-string": "^1.5.0",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
